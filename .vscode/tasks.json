{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Xeom: Build (Release)",
            "type": "shell",
            "command": "tools/build/build.bat",
            "args": ["--release"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Xeom: Build (Debug)",
            "type": "shell",
            "command": "tools/build/build.bat",
            "args": ["--debug"],
            "group": "build",
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "Xeom: Run",
            "type": "shell",
            "command": "tools/build/run.bat",
            "dependsOn": "Xeom: Build (Release)",
            "problemMatcher": []
        },
        {
            "label": "Xeom: Test",
            "type": "shell",
            "command": "tools/build/test.bat",
            "dependsOn": "Xeom: Build (Release)",
            "problemMatcher": []
        },
        {
            "label": "Xeom: Clean",
            "type": "shell",
            "command": "tools/build/build.bat",
            "args": ["--clean"],
            "problemMatcher": []
        }
    ]
}
